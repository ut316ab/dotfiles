[Unit]
Description=Mirror libvirt VM definitions and UEFI vars to /mnt/storage
# Started by libvirt-config-backup.path whenever the config changes.
# Skips quietly when the USB storage drive isn't mounted (e.g. after a warm reboot).
ConditionPathIsMountPoint=/mnt/storage

[Service]
Type=oneshot
# Let a burst of changes (virt-manager writes several files) settle into one copy.
ExecStartPre=/usr/bin/sleep 3
ExecStart=/usr/bin/mkdir -p /mnt/storage/libvirt-config-backup
ExecStart=/usr/bin/rsync -a --delete /etc/libvirt/qemu/ /mnt/storage/libvirt-config-backup/qemu/
ExecStart=/usr/bin/rsync -a --delete /var/lib/libvirt/qemu/nvram/ /mnt/storage/libvirt-config-backup/nvram/
ExecStart=/usr/bin/rsync -a --delete /var/lib/libvirt/qemu/varstore/ /mnt/storage/libvirt-config-backup/varstore/
